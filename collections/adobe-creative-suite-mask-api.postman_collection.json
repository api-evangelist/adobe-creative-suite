          "request": {
            "name": "Adobe Creative Suite Create Alpha Mask",
            "description": {
              "content": "Creates an alpha mask for an image using Adobe Sensei AI. The mask isolates the foreground subject from the background and is returned as a separate grayscale image that can be applied as a layer mask in compositing workflows.",
