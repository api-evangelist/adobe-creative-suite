          "request": {
            "name": "Adobe Creative Suite Generative Expand Image",
            "description": {
              "content": "Expands an existing image beyond its original boundaries using generative AI to fill in the new regions. The expansion can be directional and supports specifying a prompt to guide the content generated in the expanded areas.",
