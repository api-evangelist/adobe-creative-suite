          "request": {
            "name": "Adobe Creative Suite Generate Similar Images",
            "description": {
              "content": "Generates images that are visually similar to a provided reference image while optionally being guided by a text prompt. Useful for producing variations of an existing image or exploring stylistic alternatives based on a visual reference.",
