          "name": "Adobe Creative Suite Generate Images from Text Prompt",
          "request": {
            "name": "Adobe Creative Suite Generate Images from Text Prompt",
            "description": {
              "content": "Generates one or more images from a text prompt using the Adobe Firefly generative AI model. Supports optional style presets, content class selection, negative prompts, and seed values for reproducibility. The operation is asynchronous; use the returned job ID to poll for completion and retrieve output image URLs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "images",
                "generate-async"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"<string>\",\n  \"negativePrompt\": \"<string>\",\n  \"contentClass\": \"<string>\",\n  \"numVariations\": 1,\n  \"size\": {\n    \"width\": \"<integer>\",\n    \"height\": \"<integer>\"\n  },\n  \"style\": {\n    \"presets\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"strength\": \"<integer>\",\n    \"referenceImage\": {\n      \"source\": {\n        \"url\": \"<string>\",\n        \"uploadId\": \"<string>\"\n      }\n    }\n  },\n  \"seeds\": [\n    \"<integer>\",\n    \"<integer>\"\n  ],\n  \"locale\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
