{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/adobe-creative-suite/refs/heads/main/json-structure/adobe-creative-suite-firefly-image-expand-request-structure.json",
  "name": "ImageExpandRequest",
  "description": "Request body for generative image expansion",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "description": "Text prompt to guide what content fills the expanded areas",
      "maxLength": 1024,
      "example": "example_value"
    },
    "negativePrompt": {
      "type": "string",
      "description": "Text describing what to avoid in the expanded areas",
      "maxLength": 1024,
      "example": "example_value"
    },
    "image": {
      "$ref": "#/components/schemas/InputImageReference"
    },
    "size": {
      "$ref": "#/components/schemas/ImageSize"
    },
    "placement": {
      "type": "object",
      "description": "Placement and inset parameters for the source image within the expanded canvas",
      "properties": {
        "inset": {
          "type": "object",
          "properties": {
            "left": {
              "type": "int32"
            },
            "top": {
              "type": "int32"
            },
            "right": {
              "type": "int32"
            },
            "bottom": {
              "type": "int32"
            }
          }
        }
      }
    },
    "numVariations": {
      "type": "int32",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "example": 1920
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "int32"
      }
    }
  },
  "required": [
    "image"
  ]
}