{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/adobe-creative-suite/refs/heads/main/json-structure/adobe-creative-suite-firefly-generate-similar-request-structure.json",
  "name": "GenerateSimilarRequest",
  "description": "Request body for generating images similar to a reference image",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "description": "Optional text prompt to further guide the style or content",
      "maxLength": 1024,
      "example": "example_value"
    },
    "image": {
      "$ref": "#/components/schemas/InputImageReference"
    },
    "numVariations": {
      "type": "int32",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "example": 1920
    },
    "size": {
      "$ref": "#/components/schemas/ImageSize"
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "int32"
      }
    }
  },
  "required": [
    "image"
  ]
}