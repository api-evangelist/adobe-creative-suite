{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/adobe-creative-suite/refs/heads/main/json-structure/adobe-creative-suite-pdf-services-operation-status-structure.json",
  "name": "OperationStatus",
  "description": "Current status and result of a PDF Services operation",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "description": "Current status of the operation",
      "enum": [
        "in progress",
        "done",
        "failed"
      ],
      "example": "done"
    },
    "asset": {
      "$ref": "#/components/schemas/Asset"
    },
    "errors": {
      "type": "array",
      "description": "Error details if the operation failed",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}